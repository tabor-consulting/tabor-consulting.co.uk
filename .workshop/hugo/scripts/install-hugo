#!/bin/bash
set -euo pipefail

prefix=${HUGO_PREFIX:-/usr/local}

# Use the upstream binary so Workshop can access project files
# and use the separately installed Dart Sass compiler.
case "$(dpkg --print-architecture)" in
  amd64) architecture=amd64 ;;
  arm64) architecture=arm64 ;;
  *) echo "Unsupported Hugo architecture" >&2; exit 1 ;;
esac

# Shared by local development and CI, matching the reference site's Hugo pin.
version=0.170.0
archive="hugo_extended_${version}_linux-${architecture}.tar.gz"
checksums="hugo_${version}_checksums.txt"
download_dir=$(mktemp -d)
trap 'rm -rf "$download_dir"' EXIT
cd "$download_dir"
release="https://github.com/gohugoio/hugo/releases/download/v${version}"
curl -fsSL "$release/$archive" -o "$archive"
curl -fsSL "$release/$checksums" -o "$checksums"
sha256sum --check --ignore-missing "$checksums"
tar -xzf "$archive" hugo
install -d "$prefix/bin"
install -m 0755 hugo "$prefix/bin/hugo"
# Smoke-test without relying on version-output formatting; the build tests Sass.
"$prefix/bin/hugo" version

