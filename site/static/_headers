# Unmatched routes (including ordinary custom 404 responses) are not retained.
# Rules match paths, not status; missing asset URLs can match an override below.
/*
  Cache-Control: no-store

# Cloudflare matches request URLs, not the underlying index.html filename.
/
  ! Cache-Control
  Cache-Control: public, max-age=300, must-revalidate
/pages/consulting/
  ! Cache-Control
  Cache-Control: public, max-age=300, must-revalidate
/*.html
  ! Cache-Control
  Cache-Control: public, max-age=300, must-revalidate
/*.md
  ! Cache-Control
  Cache-Control: public, max-age=300, must-revalidate
/*.xml
  ! Cache-Control
  Cache-Control: no-cache
/*.json
  ! Cache-Control
  Cache-Control: no-cache
/llm*.txt
  ! Cache-Control
  Cache-Control: no-cache
/sitemap.xml
  ! Cache-Control
  Cache-Control: public, max-age=3600, must-revalidate

# Stable-name assets revalidate daily.
/*.css
  ! Cache-Control
  Cache-Control: public, max-age=86400, must-revalidate
/*.js
  ! Cache-Control
  Cache-Control: public, max-age=86400, must-revalidate
/*.png
  ! Cache-Control
  Cache-Control: public, max-age=86400, must-revalidate
/*.jpg
  ! Cache-Control
  Cache-Control: public, max-age=86400, must-revalidate
/*.jpeg
  ! Cache-Control
  Cache-Control: public, max-age=86400, must-revalidate
/*.webp
  ! Cache-Control
  Cache-Control: public, max-age=86400, must-revalidate
/*.svg
  ! Cache-Control
  Cache-Control: public, max-age=86400, must-revalidate
/*.ico
  ! Cache-Control
  Cache-Control: public, max-age=86400, must-revalidate
/*.woff
  ! Cache-Control
  Cache-Control: public, max-age=86400, must-revalidate
/*.woff2
  ! Cache-Control
  Cache-Control: public, max-age=86400, must-revalidate
/*.mp4
  ! Cache-Control
  Cache-Control: public, max-age=86400, must-revalidate

# The site's generated stylesheet has a content fingerprint. One wildcard only.
/style.main.min.*.css
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/404.html
  ! Cache-Control
  Cache-Control: no-store
